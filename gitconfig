[user]
  name = Martin Czuchra
  email = martin.czuchra@googlemail.com
  useconfigonly = true
[includeIf "gitdir:~/Development/bitcrowd/"]
  path = ~/Development/bitcrowd/.gitconfig
[core]
  excludesfile = ~/.gitignore
  pager = less -RS
[alias]
  browse = log --graph --pretty=format:'%Cred%h%Creset %Cblue(%aN)%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr, %aD)%Creset' --abbrev-commit --date=short
  tree = "!git browse -n 32"
  st = status
  co = checkout
  up = pull
  a = add
  c = commit -v
  b = branch
  pr = "!f() { git fetch -fu ${2:-origin} refs/pull/$1/head:pr/$1 && git checkout pr/$1; }; f"
  pr-clean = "!git branch --list 'pr/*' --format='%(refname:short)' | xargs -r git branch -D"
[push]
  default = upstream
[pull]
  rebase = false
[apply]
  whitespace = nowarn
[http]
  postBuffer = 157286400 # 150M.
[transfer]
  fsckObjects = true
[fetch]
  fsckObjects = true
[receive]
  fsckObjects = true
[rebase]
  instructionFormat = (%aN) - %s (%cr, %aD)
[rerere]
  enabled = true
[init]
  defaultBranch = main
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
