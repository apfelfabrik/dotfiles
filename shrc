# Shared shell configuration, sourced by both zshrc and bashrc.

# nvm (lazy loaded — stubs replace themselves on first use)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm_lazy_load() {
    unset -f nvm_lazy_load nvm node npm npx
    \. "$NVM_DIR/nvm.sh" 2>/dev/null
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  }
  nvm()  { nvm_lazy_load; nvm  "$@"; }
  node() { nvm_lazy_load; node "$@"; }
  npm()  { nvm_lazy_load; npm  "$@"; }
  npx()  { nvm_lazy_load; npx  "$@"; }
fi

export LESS=-XRS
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
# Only override TERM outside of tmux/screen
if [ -z "$TMUX" ] && [ -z "$STY" ]; then
  export TERM=xterm-256color
fi

# Preferred editor
if command -v nvim &> /dev/null; then
  alias vim="nvim"
  export EDITOR='nvim'
elif command -v vim &> /dev/null; then
  export EDITOR='vim'
else
  >&2 echo "Cannot find vim in PATH, EDITOR is '$EDITOR'"
fi

export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

[ -f ~/.secrets ] && . ~/.secrets

# Android SDK
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$PATH"

# env load helper
loadenv() {
  set -a
  . "${1:-.env}"
  set +a
}

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# Rust/Cargo
. "$HOME/.cargo/env" 2>/dev/null

# conda (lazy loaded — stub replaces itself on first use)
if [ -x /opt/homebrew/Caskroom/miniconda/base/bin/conda ]; then
  conda() {
    unset -f conda
    local shell="bash"
    [ -n "$ZSH_VERSION" ] && shell="zsh"
    local setup
    if setup="$('/opt/homebrew/Caskroom/miniconda/base/bin/conda' "shell.$shell" 'hook' 2> /dev/null)"; then
      eval "$setup"
    elif [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
      . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
    else
      export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
    fi
    conda "$@"
  }
fi

# Colors
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lAh'
alias diff='diff --color=auto'

alias xargs='xargs -o'
alias docker=podman
